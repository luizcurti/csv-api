# Server Configuration
PORT=3005

# Environment: development | production | test
NODE_ENV=development

# Path to the CSV file used as the data store (defaults to csv/data.csv)
# CSV_FILE_PATH=/absolute/path/to/data.csv

# CORS allowed origin ('*' allows any origin)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
