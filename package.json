{
  "name": "picklist-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/shared/infra/server.js",
  "scripts": {
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage --testPathPattern=\"(unit|integration)\\.spec\\.ts$\"",
    "test:watch": "jest --watch --testPathPattern=\"(unit|integration)\\.spec\\.ts$\"",
    "test:unit": "jest --testPathPattern=unit.spec.ts",
    "test:integration": "jest --testPathPattern=integration.spec.ts",
    "test:e2e": "jest --testPathPattern=e2e.spec.ts --coverage=false",
    "dev": "NODE_ENV=development ts-node-dev -r tsconfig-paths/register --inspect --transpile-only --ignore-watch node_modules --respawn src/shared/infra/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/shared/infra/server.js",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "setup": "npm install && npm run build",
    "docs:diagrams": "./scripts/generate-diagrams.sh",
    "ci": "npm run eslint && npm run format:check && npm run test && npm run build"
  },
  "author": "Luiz Curti",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "cors": "^2.8.5",
    "csv": "^6.3.11",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "yup": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
